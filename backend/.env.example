DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DB?sslmode=require
NEON_DATABASE_URL=

# Free-tier Google semantic retrieval using the same key as Flinder AI.
RAG_EMBEDDING_PROVIDER=gemini
RAG_EMBEDDING_MODEL=gemini-embedding-001
RAG_EMBEDDING_DIMENSION=384
GEMINI_API_KEY=replace_with_the_same_key_used_by_flinder_ai
SUBMISSION_CONFIDENCE_THRESHOLD=0.7
DUPLICATE_SCORE_THRESHOLD=0.92

# Optional: connect the already-deployed Flinder AI / Gemini-compatible chat API.
AI_CHAT_URL=https://your-flinder-ai-url
AI_SHARED_TOKEN=replace_with_the_same_shared_token

# Optional paid fallback, not needed for the free path.
OPENAI_API_KEY=
RAG_CHAT_MODEL=gpt-4o-mini
